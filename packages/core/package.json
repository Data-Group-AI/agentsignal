{
  "name": "@agentsignalnet/core",
  "version": "0.2.73",
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared rules behind AgentSignal: message schemas, the endpoints we are willing to fetch, and emergency-priority arithmetic.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./endpoints": {
      "types": "./dist/endpoints.d.ts",
      "default": "./dist/endpoints.js"
    },
    "./priority": {
      "types": "./dist/priority.d.ts",
      "default": "./dist/priority.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "tsup": "^8.5.0",
    "vitest": "^4.1.12"
  },
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://agentsignal.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Data-Group-AI/agentsignal.git",
    "directory": "packages/core"
  },
  "keywords": [
    "agents",
    "agentsignal",
    "notifications",
    "push-notifications"
  ]
}